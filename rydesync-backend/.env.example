#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=
#POSTGRES_DB=ridesync_db
#POSTGRES_SERVER=localhost
#POSTGRES_PORT=5432


# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=
APP_VERSION=
APP_ENV=
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=
BACKEND_CORS_ORIGINS=

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=


# ── Mobile App API Key ────────────────────────────────────────────────────────
# Every request from the Flutter app must include: X-API-Key: <this value>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In APP_ENV=development this check is SKIPPED (Swagger UI works without it)
MOBILE_API_KEY=



# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ridesync

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
RIDE_CACHE_TTL_SECONDS=30
# ride data cache lifetime

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Ride-Hailing Platforms ────────────────────────────────────────────────────
# When real API keys are available, populate these.
# The system uses simulated data by default.
UBER_API_KEY=
BOLT_API_KEY=
YANGO_API_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
SURGE_THRESHOLD_MULTIPLIER=1.3
# 30% above baseline = surge
PREDICTION_HISTORY_DAYS=30
# days of history for surge model

# ── Google Maps Platform ──────────────────────────────────────────────────────
# Enable these APIs in Google Cloud Console (all have free-tier monthly quotas):
#   - Geocoding API         (40,000 req/month free)
#   - Places API            (autocomplete: $17/1000 after $200 monthly credit)
#   - Distance Matrix API   (40,000 elements/month free)
# Restrict your key to these 3 APIs and to your server's IP in Cloud Console.
#GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Firebase Cloud Messaging (Push Notifications) ─────────────────────────────
# Step 1: Create a Firebase project at https://console.firebase.google.com
# Step 2: Project Settings → Service Accounts → Generate new private key
# Step 3: Save the JSON file and set the path below (local dev)
#         OR base64-encode it for cloud deployment:
#         base64 -w 0 firebase-service-account.json
# FIREBASE_CREDENTIALS_PATH is intentionally unset — creds now live in FIREBASE_CREDENTIALS_JSON below
# FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_COMPARE_ANONYMOUS=
RATE_LIMIT_COMPARE_AUTHENTICATED=
RATE_LIMIT_GEOCODE=


# ── WebSocket ─────────────────────────────────────────────────────────────────
# how often to push updated prices to connected clients
WS_PRICE_REFRESH_SECONDS=30
# max concurrent WS connections per comparison
WS_MAX_CONNECTIONS_PER_USER=5

# macOS: prevents Celery worker fork() crash (ObjC runtime not fork-safe)
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
